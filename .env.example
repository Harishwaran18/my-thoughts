# My Thoughts — configuration reference
# Copy this file to .env (or edit the values directly in app/routes.py).
# All settings below are optional — the blog works with sensible defaults.

# --- Site identity ---
SITE_AUTHOR=Harishwaran
SITE_TAGLINE=Thoughts on technology, learning, and the craft of building.
# Used for absolute canonical URLs in OG/Twitter meta tags + RSS.
SITE_URL=http://localhost:5000

# --- Admin credentials (change these!) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Giscus comments (optional) ---
# 1. Enable Discussions on your GitHub repo (Settings > General)
# 2. Install the giscus app: https://github.com/apps/giscus
# 3. Fill in the IDs below (get them from https://giscus.io)
# 4. Set GISCUS_ENABLED=true
GISCUS_ENABLED=false
GISCUS_REPO=Harishwaran18/my-thoughts
GISCUS_REPO_ID=R_kgDOTy-6PQ
GISCUS_CATEGORY=Announcements
GISCUS_CATEGORY_ID=DIC_kwDOTy-6Pc4DC_iP
